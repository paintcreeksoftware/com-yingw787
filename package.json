{
  "name": "com-yingw787",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "check": "tsc --noEmit && eslint . && prettier . --check && markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "fix": "eslint . --fix && prettier . --write",
    "check-bundle-size": "bundlewatch",
    "check-licenses": "licensee --production --errors-only",
    "check-dead-links": "linkinator ./out --recurse --check-css --check-fragments --timeout 15000 --status-code 429:warn --verbosity error",
    "check-external-links": "linkinator ./out --recurse --check-css --check-fragments --timeout 15000 --retry --retry-errors --status-code 429:warn --verbosity error",
    "test:smoke": "playwright test"
  },
  "bundlewatch": {
    "files": [
      {
        "path": ".next/static/chunks/*.js",
        "maxSize": "265kB"
      },
      {
        "path": ".next/static/chunks/*.css",
        "maxSize": "31kB"
      }
    ]
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.2.0",
    "clsx": "^2.1.1",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bundlewatch": "^0.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "licensee": "12.0.2",
    "linkinator": "^7.6.1",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "serve": "14.2.8",
    "sharp": "0.35.5",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bundlewatch": {
      "axios": "^0.34.0"
    },
    "linkinator": {
      "glob": "^14.0.2"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    }
  }
}
