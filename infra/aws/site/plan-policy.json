{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDedicatedStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_STATE_BUCKET"
    },
    {
      "Sid": "ReadSiteState",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::YOUR_STATE_BUCKET/yingw787.com/site.tfstate"
    },
    {
      "Sid": "ManageSitePlanLock",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR_STATE_BUCKET/yingw787.com/site.tfstate.tflock"
    },
    {
      "Sid": "ReadWebsiteBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration"
      ],
      "Resource": "arn:aws:s3:::*",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "YOUR_ACCOUNT_ID"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudfront::YOUR_ACCOUNT_ID:distribution/*"
    },
    {
      "Effect": "Allow",
      "Action": "cloudfront:GetOriginAccessControl",
      "Resource": "arn:aws:cloudfront::YOUR_ACCOUNT_ID:origin-access-control/*"
    },
    {
      "Effect": "Allow",
      "Action": "cloudfront:GetCachePolicy",
      "Resource": "arn:aws:cloudfront::YOUR_ACCOUNT_ID:cache-policy/*"
    },
    {
      "Effect": "Allow",
      "Action": "cloudfront:GetResponseHeadersPolicy",
      "Resource": "arn:aws:cloudfront::YOUR_ACCOUNT_ID:response-headers-policy/*"
    },
    {
      "Effect": "Allow",
      "Action": ["cloudfront:DescribeFunction", "cloudfront:GetFunction"],
      "Resource": "arn:aws:cloudfront::YOUR_ACCOUNT_ID:function/yingw787-directory-index"
    },
    {
      "Effect": "Allow",
      "Action": ["acm:DescribeCertificate", "acm:ListTagsForCertificate"],
      "Resource": "arn:aws:acm:us-east-1:YOUR_ACCOUNT_ID:certificate/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource"
      ],
      "Resource": "arn:aws:route53:::hostedzone/YOUR_ZONE_ID"
    },
    {
      "Effect": "Allow",
      "Action": "iam:GetOpenIDConnectProvider",
      "Resource": "arn:aws:iam::YOUR_ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::YOUR_ACCOUNT_ID:role/yingw787-github-publish"
    }
  ]
}
